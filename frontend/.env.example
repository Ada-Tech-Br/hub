# URL usada pelo browser para chamar a API (axios + iframe de conteúdo).
VITE_API_URL=http://localhost:8000
# Opcional (Vercel): host do FastAPI para proxy em vercel.json quando VITE_API_URL for o domínio do SPA.
# VITE_BACKEND_URL=https://api.seudominio.com
VITE_APP_NAME=Ada Platform
VITE_GOOGLE_CLIENT_ID=your-google-client-id
# Same domains as backend GOOGLE_ALLOWED_EMAIL_DOMAINS (comma-separated).
# If exactly one domain, the login URL adds Google OAuth `hd` for the account picker.
VITE_GOOGLE_ALLOWED_EMAIL_DOMAINS=your-workspace-domain.com
